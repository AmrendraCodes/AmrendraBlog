# Required in production
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
CRON_SECRET="generate-a-long-random-secret"
BLOB_READ_WRITE_TOKEN="vercel-blob-token"
PUBLIC_SITE_URL="https://www.codewithamrendra.in"
CMS_REVALIDATE_SECRET="shared-secret-with-public-site"

# Public URLs used by the CMS UI and password-reset links
NEXT_PUBLIC_SITE_URL="https://admin.example.com"
NEXT_PUBLIC_APP_URL="https://admin.example.com"

# Optional email delivery for password reset notifications
RESEND_API_KEY="re_..."
EMAIL_FROM="Code with Amrendra <noreply@example.com>"

# Optional first-admin bootstrap; remove after initial setup
ADMIN_INITIAL_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="replace-before-deploy"

# Development only; never set this in production
DEV_SEED_ADMIN_TOKEN="local-development-token"
