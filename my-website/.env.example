# Content Source
# "database" (default) -> requires DATABASE_URL
# "markdown" -> uses files from content/posts (useful for local development without DB)
CONTENT_SOURCE=database

# Database (required when CONTENT_SOURCE=database)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
CMS_REVALIDATE_SECRET="shared-secret-with-cms"

# Optional: enables IndexNow submission from /api/indexnow
INDEXNOW_KEY="indexnow-key"

# Optional: admin redirect target; defaults to the deployed CMS URL
ADMIN_APP_URL="https://admin.example.com"
